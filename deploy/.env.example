# 複製為 .env 並填入（.env 已列入 .gitignore，不要提交）。說明見 docs/deploy.md。

# relay 的網域（DNS A 記錄指向本機；relay 以此向 LetsEncrypt 申請憑證）
HILLS_RELAY_HOST=relay.example.com

# LetsEncrypt 聯絡信箱（憑證到期通知）
HILLS_RELAY_CONTACT=admin@example.com

# 本機的公網 IP；mailbox 會把 <IP>:<UDP 埠> 寫進 mailbox 連線碼
HILLS_PUBLIC_IP=203.0.113.5

# mailbox 的 UDP 埠（防火牆需開放）
HILLS_UDP_PORT=7843

# CAFECA 錢包網址（以 CAFECA 登入，technical-design §17.1）；mailbox 需能以 HTTPS 連到此網址與鏈上 RPC
HILLS_CAFECA_WALLET=https://wallet.example.com
# 選填：自架的鏈上 RPC（預設使用錢包設定檔中的 rpcUrl）
# HILLS_CAFECA_RPC=https://rpc.example.com
# 開發測試模式（D44）：1 = 接受開發版 app 的測試帳號登入，此時可不設 HILLS_CAFECA_WALLET。
# 測試帳號沒有簽章保護，正式伺服器不得設定。
# HILLS_DEV_LOGIN=1

# 選填：事先固定組織根金鑰公鑰（64 位 hex）。留空時由第一位建立組織的管理者綁定。
HILLS_ORG_ROOT_PUB=

# 選填：mailbox 健康檢查在主機上的埠（只綁 127.0.0.1，預設 18080）
HILLS_HEALTH_PORT=18080

# 選填：儲存節點 storage-0…7 的 UDP 埠（預設 7850–7857，防火牆需開放）
# HILLS_STORAGE_PORT_0=7850
# …
# HILLS_STORAGE_PORT_7=7857

# 選填：每位成員在每個儲存節點的配額（bytes，預設 20 GB）
HILLS_QUOTA_BYTES=21474836480
