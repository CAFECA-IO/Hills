# 自架 iroh-relay（technical-design §10、§16.9）
FROM rust:1-bookworm AS build
RUN cargo install iroh-relay --version 1.4.1 --locked --features server

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /usr/local/cargo/bin/iroh-relay /usr/local/bin/iroh-relay
COPY relay-entrypoint.sh /usr/local/bin/relay-entrypoint.sh
RUN chmod 0755 /usr/local/bin/relay-entrypoint.sh
WORKDIR /data
ENTRYPOINT ["/usr/local/bin/relay-entrypoint.sh"]
